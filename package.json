{
  "name": "@ferndev/framework",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "publint": "publint packages/core && publint packages/woo",
    "attw": "attw --pack packages/core && attw --pack packages/woo",
    "size": "size-limit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/bun": "^1.3.2",
    "eslint": "^10.4.1",
    "publint": "^0.3.21",
    "size-limit": "^12.1.0",
    "typescript-eslint": "^8.60.1"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  }
}
