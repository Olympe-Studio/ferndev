{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "composite": true,
    "target": "esnext",
    "downlevelIteration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "allowJs": false
  },
  "include": [
    "./index.ts"
  ]
}
