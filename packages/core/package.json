{
  "name": "@ferndev/core",
  "version": "2.0.0",
  "description": "Core browser features to work with the Fern Framework",
  "main": "./dist/fern_core.umd.cjs",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "author": "Tanguy Magnaudet <tanguy@olympe-studio.xyz>",
  "license": "MIT",
  "module": "./dist/fern_core.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/fern_core.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/fern_core.umd.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.d.ts dist/index.d.cts",
    "prepack": "bun run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  }
}